{
  "name": "stackconsolev2",
  "productName": "StackConsole",
  "version": "1.0.0-beta.1",
  "description": "Multi-process microservice engine and interactive local service terminal dashboard.",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "terminal",
    "laravel",
    "python",
    "process-manager",
    "developer-tools"
  ],
  "author": "Sherwin Vizcarra",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "artifactName": "${productName}-v${version}-${arch}.${ext}",
    "appId": "com.stack.console",
    "directories": {
      "output": "release/beta"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "services/**/*"
    ],
    "asarUnpack": ["services/**"],
    "win": {
      "icon": "src/assets/logo/stacklogo-x256.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StackConsole"
    }
  }
  
}
